rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /worker_verifications/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Verification uploads are owned by the authenticated backend. Admin SDK
      // access bypasses these client rules.
      allow write: if false;
    }
  }
}
