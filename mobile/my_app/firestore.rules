rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function verifiedWorker() {
      return signedIn()
        && currentUser().role == 'worker'
        && currentUser().verificationStatus == 'verified';
    }
    function validOptionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }
    function validServiceRequest(data) {
      return data.keys().hasAll([
          'clientId', 'clientName', 'title', 'category', 'budget', 'schedule',
          'location', 'description', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'clientId', 'clientName', 'title', 'category', 'budget', 'schedule',
          'scheduleFrom', 'scheduleTo', 'location', 'description', 'status',
          'createdAt', 'workerId', 'workerName', 'acceptedAt', 'cancelledAt',
          'ongoingAt', 'completedAt'
        ])
        && data.clientId is string
        && data.clientId.size() > 0
        && data.clientId.size() <= 128
        && data.clientName is string
        && data.clientName.size() > 0
        && data.clientName.size() <= 120
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 100
        && data.budget is number
        && data.budget > 0
        && data.budget <= 10000000
        && data.schedule is timestamp
        && (!('scheduleFrom' in data) || data.scheduleFrom is timestamp)
        && (!('scheduleTo' in data) || data.scheduleTo is timestamp)
        && (!('scheduleFrom' in data) || !('scheduleTo' in data)
          || data.scheduleFrom <= data.scheduleTo)
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 300
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 5000
        && data.status in ['pending', 'accepted', 'ongoing', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && validOptionalString(data, 'workerId', 128)
        && validOptionalString(data, 'workerName', 120);
    }
    function validApplication(data) {
      return data.keys().hasAll([
          'requestId', 'clientId', 'workerId', 'workerName', 'status',
          'appliedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'clientId', 'workerId', 'workerName', 'status',
          'appliedAt', 'reviewedAt'
        ])
        && data.requestId is string
        && data.requestId.size() > 0
        && data.requestId.size() <= 128
        && data.clientId is string
        && data.clientId.size() > 0
        && data.clientId.size() <= 128
        && data.workerId is string
        && data.workerId.size() > 0
        && data.workerId.size() <= 128
        && data.workerName is string
        && data.workerName.size() > 0
        && data.workerName.size() <= 120
        && data.status in ['pending', 'accepted', 'rejected']
        && data.appliedAt is timestamp
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp);
    }

    // Allows a worker to query their own applications across every request.
    // The workerId query constraint is required for Firestore to authorize it.
    match /{path=**}/applications/{applicationId} {
      allow read: if signedIn()
        && resource.data.workerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if self(uid);
      allow create: if false;
      allow update: if self(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.verificationStatus == resource.data.verificationStatus;
    }

    match /worker_profiles/{uid} {
      allow read: if signedIn();
      allow write: if self(uid)
        && request.resource.data.verificationStatus == resource.data.verificationStatus;
    }

    match /service_categories/{categoryId} {
      allow read: if signedIn();
      // Category management is restricted to the authenticated admin backend.
      allow create, update, delete: if false;
    }

    match /service_requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validServiceRequest(request.resource.data)
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if validServiceRequest(request.resource.data) && (
        (
          self(resource.data.clientId)
          && resource.data.status in ['pending', 'accepted']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt'])
          && request.resource.data.cancelledAt == request.time
        ) || (
          self(resource.data.clientId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.workerId is string
          && request.resource.data.workerName is string
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'workerId', 'workerName', 'acceptedAt'])
          && getAfter(/databases/$(database)/documents/service_requests/$(requestId)/applications/$(request.resource.data.workerId)).data.status == 'accepted'
        ) || (
          self(resource.data.workerId)
          && request.resource.data.workerId == resource.data.workerId
          && (
            (
              resource.data.status == 'accepted'
              && request.resource.data.status == 'ongoing'
              && request.resource.data.ongoingAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'ongoingAt'])
            ) || (
              resource.data.status == 'ongoing'
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'completedAt'])
            )
          )
        )
      );

      match /applications/{workerId} {
        allow read: if signedIn()
          && (
            request.auth.uid == workerId
            || resource.data.workerId == request.auth.uid
            || get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.auth.uid
          );
        allow create: if verifiedWorker()
          && request.auth.uid == workerId
          && validApplication(request.resource.data)
          && request.resource.data.workerId == workerId
          && request.resource.data.requestId == requestId
          && request.resource.data.status == 'pending'
          && request.resource.data.appliedAt == request.time
          && get(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'pending'
          && request.resource.data.clientId
            == get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId;
        allow update: if signedIn()
          && validApplication(request.resource.data)
          && get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt'])
          && (
            (
              request.resource.data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.workerId == workerId
            ) || (
              request.resource.data.status == 'rejected'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.workerId != workerId
            )
          );
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'requestId', 'participantIds', 'clientId', 'clientName', 'workerId',
          'workerName', 'lastMessage', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestId', 'participantIds', 'clientId', 'clientName', 'workerId',
          'workerName', 'lastMessage', 'updatedAt'
        ])
        && conversationId == request.resource.data.clientId + '_' + request.resource.data.workerId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.clientId in request.resource.data.participantIds
        && request.resource.data.workerId in request.resource.data.participantIds
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() <= 120
        && request.resource.data.workerName is string
        && request.resource.data.workerName.size() <= 120
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId == request.auth.uid
        && getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.workerId == request.resource.data.workerId;
      match /messages/{messageId} {
        allow read, create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'recipientId', 'senderId', 'requestId', 'title', 'body', 'read',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'recipientId', 'senderId', 'requestId', 'title', 'body', 'read',
          'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.recipientId
              == get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId
            && existsAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)/applications/$(request.auth.uid))
          ) || (
            request.auth.uid
              == get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId
            && request.resource.data.recipientId
              == getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.workerId
          )
        );
    }

    match /worker_verifications/{uid} {
      allow read: if self(uid);
      // Verification records are written only through the Firebase Admin SDK
      // after the backend has compared the exact uploaded image buffers.
      allow create, update, delete: if false;
    }

    match /reviews/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.auth.uid;
    }
  }
}
