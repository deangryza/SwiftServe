rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function verifiedWorker() {
      return signedIn()
        && currentUser().role == 'worker'
        && currentUser().verificationStatus == 'verified';
    }
    function validOptionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }
    function validPublicProfile(uid, data) {
      return data.keys().hasAll([
          'uid', 'fullName', 'role', 'photoBase64', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'role', 'photoBase64', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 120
        && data.role in ['client', 'worker']
        && data.photoBase64 is string
        && data.photoBase64.size() <= 65536
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt == request.time;
    }
    function validServiceRequest(data) {
      return data.keys().hasAll([
          'clientId', 'clientName', 'title', 'category', 'budget', 'schedule',
          'location', 'description', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'clientId', 'clientName', 'title', 'category', 'budget', 'schedule',
          'scheduleFrom', 'scheduleTo', 'location', 'description', 'status',
          'areaPosition', 'createdAt', 'workerId', 'workerName', 'acceptedAt',
          'cancelledAt', 'ongoingAt', 'completedAt', 'modality',
          'dropoffLocation', 'dropoffAreaPosition', 'errandItems',
          'itemCostEstimate', 'distanceKm', 'errandStage', 'pickedUpAt',
          'deliveringAt'
        ])
        && data.clientId is string
        && data.clientId.size() > 0
        && data.clientId.size() <= 128
        && data.clientName is string
        && data.clientName.size() > 0
        && data.clientName.size() <= 120
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 100
        && data.budget is number
        && data.budget > 0
        && data.budget <= 10000000
        && data.schedule is timestamp
        && (!('scheduleFrom' in data) || data.scheduleFrom is timestamp)
        && (!('scheduleTo' in data) || data.scheduleTo is timestamp)
        && (!('scheduleFrom' in data) || !('scheduleTo' in data)
          || data.scheduleFrom <= data.scheduleTo)
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 300
        && (!('areaPosition' in data) || data.areaPosition is latlng)
        && (!('modality' in data)
          || data.modality in ['onsite', 'online', 'hybrid', 'errand'])
        && validOptionalString(data, 'dropoffLocation', 300)
        && (!('dropoffAreaPosition' in data) || data.dropoffAreaPosition is latlng)
        && validOptionalString(data, 'errandItems', 500)
        && (!('itemCostEstimate' in data)
          || (data.itemCostEstimate is number
            && data.itemCostEstimate > 0
            && data.itemCostEstimate <= 10000000))
        && (!('distanceKm' in data)
          || (data.distanceKm is number
            && data.distanceKm >= 0
            && data.distanceKm <= 1000))
        && (!('errandStage' in data)
          || data.errandStage in ['headingToPickup', 'pickedUp', 'delivering'])
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 5000
        && data.status in ['pending', 'accepted', 'ongoing', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && validOptionalString(data, 'workerId', 128)
        && validOptionalString(data, 'workerName', 120);
    }
    function validExactLocation(data) {
      return data.keys().hasAll(['position', 'address', 'createdAt'])
        && data.keys().hasOnly([
          'position', 'address', 'dropoffPosition', 'dropoffAddress',
          'createdAt'
        ])
        && data.position is latlng
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 300
        && (!('dropoffPosition' in data) || data.dropoffPosition is latlng)
        && (!('dropoffAddress' in data)
          || (data.dropoffAddress is string
            && data.dropoffAddress.size() > 0
            && data.dropoffAddress.size() <= 300))
        && data.createdAt is timestamp;
    }
    function validRiderLocation(data) {
      return data.keys().hasAll(['position', 'updatedAt'])
        && data.keys().hasOnly(['position', 'heading', 'speed', 'updatedAt'])
        && data.position is latlng
        && (!('heading' in data) || data.heading is number)
        && (!('speed' in data) || data.speed is number)
        && data.updatedAt == request.time;
    }
    function validApplication(data) {
      return data.keys().hasAll([
          'requestId', 'clientId', 'workerId', 'workerName', 'status',
          'appliedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'clientId', 'workerId', 'workerName', 'status',
          'appliedAt', 'reviewedAt'
        ])
        && data.requestId is string
        && data.requestId.size() > 0
        && data.requestId.size() <= 128
        && data.clientId is string
        && data.clientId.size() > 0
        && data.clientId.size() <= 128
        && data.workerId is string
        && data.workerId.size() > 0
        && data.workerId.size() <= 128
        && data.workerName is string
        && data.workerName.size() > 0
        && data.workerName.size() <= 120
        && data.status in ['pending', 'accepted', 'rejected']
        && data.appliedAt is timestamp
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp);
    }

    // Allows a worker to query their own applications across every request.
    // The workerId query constraint is required for Firestore to authorize it.
    match /{path=**}/applications/{applicationId} {
      allow read: if signedIn()
        && resource.data.workerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if self(uid);
      allow create: if false;
      allow update: if self(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.phoneNumber == resource.data.phoneNumber
        && validOptionalString(request.resource.data, 'photoBase64', 65536);
    }

    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow create: if self(uid) && validPublicProfile(uid, request.resource.data);
      allow update: if self(uid)
        && resource.data.role == request.resource.data.role
        && validPublicProfile(uid, request.resource.data);
      allow delete: if false;
    }

    match /worker_profiles/{uid} {
      allow read: if signedIn();
      allow write: if self(uid)
        && request.resource.data.verificationStatus == resource.data.verificationStatus;
    }

    match /service_categories/{categoryId} {
      // Public so the registration form can list categories before sign-in.
      allow read: if true;
      // Category management is restricted to the authenticated admin backend.
      allow create, update, delete: if false;
    }

    match /service_requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validServiceRequest(request.resource.data)
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        // Online jobs carry no map pin; on-site and hybrid jobs need both the
        // public area and the private exact location.
        && (
          (
            request.resource.data.get('modality', 'onsite') == 'online'
            && !('areaPosition' in request.resource.data)
            && !existsAfter(/databases/$(database)/documents/service_requests/$(requestId)/private/location)
          ) || (
            request.resource.data.get('modality', 'onsite') != 'online'
            && request.resource.data.areaPosition is latlng
            && existsAfter(/databases/$(database)/documents/service_requests/$(requestId)/private/location)
          )
        )
        && !('errandStage' in request.resource.data)
        // Errands also need a drop-off, publicly as an area and privately as
        // the exact point. Other work types never carry errand fields.
        && (
          (
            request.resource.data.get('modality', 'onsite') == 'errand'
            && request.resource.data.dropoffAreaPosition is latlng
            && request.resource.data.dropoffLocation is string
            && request.resource.data.errandItems is string
            && request.resource.data.errandItems.size() > 0
            && request.resource.data.distanceKm is number
            && getAfter(/databases/$(database)/documents/service_requests/$(requestId)/private/location).data.dropoffPosition is latlng
          ) || (
            request.resource.data.get('modality', 'onsite') != 'errand'
            && !request.resource.data.keys().hasAny([
              'dropoffLocation', 'dropoffAreaPosition', 'errandItems',
              'itemCostEstimate', 'distanceKm'
            ])
          )
        );
      allow update: if validServiceRequest(request.resource.data) && (
        (
          self(resource.data.clientId)
          && resource.data.status in ['pending', 'accepted']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt'])
          && request.resource.data.cancelledAt == request.time
        ) || (
          self(resource.data.clientId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.workerId is string
          && request.resource.data.workerName is string
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'workerId', 'workerName', 'acceptedAt'])
          && getAfter(/databases/$(database)/documents/service_requests/$(requestId)/applications/$(request.resource.data.workerId)).data.status == 'accepted'
        ) || (
          self(resource.data.workerId)
          && request.resource.data.workerId == resource.data.workerId
          && (
            (
              resource.data.status == 'accepted'
              && request.resource.data.status == 'ongoing'
              && request.resource.data.ongoingAt == request.time
              && (
                (
                  resource.data.get('modality', 'onsite') != 'errand'
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'ongoingAt'])
                ) || (
                  // Starting an errand puts the rider on the way to pickup.
                  resource.data.get('modality', 'onsite') == 'errand'
                  && request.resource.data.errandStage == 'headingToPickup'
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'ongoingAt', 'errandStage'])
                )
              )
            ) || (
              resource.data.status == 'ongoing'
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'completedAt'])
              // An errand is delivered only after the rider is on the way.
              // Errands started before stages existed have no stage.
              && resource.data.get('errandStage', 'delivering') == 'delivering'
            ) || (
              // Errand stages only move forward, one step at a time.
              resource.data.status == 'ongoing'
              && request.resource.data.status == 'ongoing'
              && resource.data.get('modality', 'onsite') == 'errand'
              && (
                (
                  resource.data.get('errandStage', '') == 'headingToPickup'
                  && request.resource.data.errandStage == 'pickedUp'
                  && request.resource.data.pickedUpAt == request.time
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['errandStage', 'pickedUpAt'])
                ) || (
                  resource.data.get('errandStage', '') == 'pickedUp'
                  && request.resource.data.errandStage == 'delivering'
                  && request.resource.data.deliveringAt == request.time
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['errandStage', 'deliveringAt'])
                )
              )
            )
          )
        )
      );

      match /applications/{workerId} {
        allow read: if signedIn()
          && (
            request.auth.uid == workerId
            || resource.data.workerId == request.auth.uid
            || get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.auth.uid
          );
        allow create: if verifiedWorker()
          && request.auth.uid == workerId
          && validApplication(request.resource.data)
          && request.resource.data.workerId == workerId
          && request.resource.data.requestId == requestId
          && request.resource.data.status == 'pending'
          && request.resource.data.appliedAt == request.time
          && get(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'pending'
          && request.resource.data.clientId
            == get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId;
        allow update: if signedIn()
          && validApplication(request.resource.data)
          && get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt'])
          && (
            (
              request.resource.data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.workerId == workerId
            ) || (
              request.resource.data.status == 'rejected'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.workerId != workerId
            )
          );
        allow delete: if false;
      }

      match /private/{privateDocumentId} {
        function parent() {
          return get(/databases/$(database)/documents/service_requests/$(requestId)).data;
        }
        allow read: if privateDocumentId in ['location', 'rider_location']
          && signedIn()
          && (
            parent().clientId == request.auth.uid
            || (
              parent().workerId == request.auth.uid
              && parent().status in ['accepted', 'ongoing', 'completed']
            )
          );
        allow create: if privateDocumentId == 'location'
          && signedIn()
          && validExactLocation(request.resource.data)
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.auth.uid;
        // Only the assigned rider writes their live position, and only while
        // the errand is underway.
        allow create, update: if privateDocumentId == 'rider_location'
          && signedIn()
          && parent().get('modality', 'onsite') == 'errand'
          && parent().workerId == request.auth.uid
          && parent().status == 'ongoing'
          && validRiderLocation(request.resource.data);
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'requestId', 'participantIds', 'clientId', 'clientName', 'workerId',
          'workerName', 'lastMessage', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestId', 'participantIds', 'clientId', 'clientName', 'workerId',
          'workerName', 'lastMessage', 'updatedAt'
        ])
        && (
          conversationId == request.resource.data.clientId + '_' + request.resource.data.workerId
          || conversationId == request.resource.data.requestId
        )
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.clientId in request.resource.data.participantIds
        && request.resource.data.workerId in request.resource.data.participantIds
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() <= 120
        && request.resource.data.workerName is string
        && request.resource.data.workerName.size() <= 120
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId == request.resource.data.clientId
        && getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.workerId == request.resource.data.workerId;
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/user_blocks/$(request.auth.uid + '_' + get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[0]))
          && !exists(/databases/$(database)/documents/user_blocks/$(request.auth.uid + '_' + get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[1]))
          && !exists(/databases/$(database)/documents/user_blocks/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[0] + '_' + request.auth.uid))
          && !exists(/databases/$(database)/documents/user_blocks/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[1] + '_' + request.auth.uid));
      }
    }

    match /user_blocks/{blockId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/user_blocks/$(blockId))
          || resource.data.blockerId == request.auth.uid
          || resource.data.blockedId == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.blockerId == request.auth.uid
          || resource.data.blockedId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'blockerId', 'blockedId', 'conversationId', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'blockerId', 'blockedId', 'conversationId', 'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds
        && request.resource.data.blockedId in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'recipientId', 'senderId', 'requestId', 'title', 'body', 'read',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'recipientId', 'senderId', 'requestId', 'title', 'body', 'read',
          'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.recipientId
              == get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId
            && existsAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)/applications/$(request.auth.uid))
          ) || (
            request.auth.uid
              == get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId
            && request.resource.data.recipientId
              == getAfter(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.workerId
          )
        );
    }

    match /worker_verifications/{uid} {
      allow read: if self(uid);
      // Verification records are written only through the Firebase Admin SDK
      // after the backend has compared the exact uploaded image buffers.
      allow create, update, delete: if false;
    }

    match /reviews/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'requestId', 'clientId', 'workerId', 'workerName', 'rating',
          'comment', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestId', 'clientId', 'workerId', 'workerName', 'rating',
          'comment', 'createdAt'
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.workerId is string
        && request.resource.data.workerName is string
        && request.resource.data.workerName.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/service_requests/$(requestId)).data.workerId == request.resource.data.workerId
        && get(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'completed';
    }

    match /client_reviews/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'requestId', 'workerId', 'clientId', 'clientName', 'rating',
          'comment', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestId', 'workerId', 'clientId', 'clientName', 'rating',
          'comment', 'createdAt'
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.clientId is string
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/service_requests/$(requestId)).data.workerId == request.auth.uid
        && get(/databases/$(database)/documents/service_requests/$(requestId)).data.clientId == request.resource.data.clientId
        && get(/databases/$(database)/documents/service_requests/$(requestId)).data.status == 'completed';
    }

    match /reports/{reportId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/reports/$(reportId))
          || resource.data.reporterId == request.auth.uid);
      allow list: if signedIn()
        && resource.data.reporterId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'requestId', 'reporterId', 'reportedUserId', 'reportedUserName',
          'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requestId', 'reporterId', 'reportedUserId', 'reportedUserName',
          'reason', 'details', 'status', 'createdAt'
        ])
        && reportId == request.resource.data.requestId + '_' + request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserName is string
        && request.resource.data.reportedUserName.size() <= 120
        && request.resource.data.reason in [
          'Inappropriate behavior', 'Fraud or scam', 'Poor service',
          'Safety concern', 'Other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && (
          (
            get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId == request.auth.uid
            && get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.workerId == request.resource.data.reportedUserId
          ) || (
            get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.workerId == request.auth.uid
            && get(/databases/$(database)/documents/service_requests/$(request.resource.data.requestId)).data.clientId == request.resource.data.reportedUserId
          )
        );
    }
  }
}
