# Copy values only after reviewing docs; never commit credentials.
EXPIRED_JOB_CLEANUP_ENABLED=false
EXPIRED_JOB_CLEANUP_DRY_RUN=true
EXPIRY_METADATA_WRITES_ENABLED=false
EXPIRY_PUSH_ENABLED=false
EXPIRY_TOKEN_REGISTRATION_ENABLED=false
EXPIRY_EXPECTED_PROJECT=swiftserve-production
EXPIRY_DATABASE=(default)
EXPIRY_REGION=us-central1
# Set only after the runtime identity is approved; otherwise deployment must wait.
EXPIRY_SERVICE_ACCOUNT=

# New activity pipeline is independent of expiration; both gates stay closed.
ACTIVITY_EVENTS_ENABLED=false
ACTIVITY_PUSH_ENABLED=false
ACTIVITY_PUSH_DRY_RUN=true
