PORT=5000
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
FIREBASE_STORAGE_BUCKET=swiftserve-production.firebasestorage.app
# Face match similarity (0-100). >= auto-verify min marks the worker verified;
# between the two goes to admin review; below review min is a mismatch.
FACE_AUTO_VERIFY_MIN=75
FACE_REVIEW_MIN=60
# TODO(billing): local disk while there is no Storage bucket (no Blaze plan).
# Use gcs + a real FIREBASE_STORAGE_BUCKET once billing is enabled.
VERIFICATION_STORAGE=local
UPLOADS_DIR=./uploads
# Road routing for errand maps. Get a free token at openrouteservice.org (dashboard -> tokens).
ORS_API_KEY=

# Opt-in backend scheduler. Keep dry-run enabled until its log is reviewed.
EXPIRED_JOB_CLEANUP_ENABLED=false
EXPIRED_JOB_CLEANUP_DRY_RUN=true

# Future dedicated Linux worker only. These paths must be on a real Render disk.
# API instances must keep EXPIRED_JOB_CLEANUP_ENABLED disabled.
GOOGLE_CLOUD_PROJECT=swiftserve-production
EXPIRED_JOB_CLEANUP_DISK_MOUNT=/var/data
EXPIRED_JOB_CLEANUP_STATE_DIR=/var/data/expiry
# Render Pro+ managed OIDC sets GOOGLE_APPLICATION_CREDENTIALS automatically.
# Do not copy the development service-account path into that worker.
