PORT=5000
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
# Hosted (Railway): use this instead of the path above, base64 of the key file.
# FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=swiftserve-production.firebasestorage.app
# Face match similarity (0-100). >= auto-verify min marks the worker verified;
# between the two goes to admin review; below review min is a mismatch.
FACE_AUTO_VERIFY_MIN=75
FACE_REVIEW_MIN=60
# TODO(billing): local disk while there is no Storage bucket (no Blaze plan).
# Use gcs + a real FIREBASE_STORAGE_BUCKET once billing is enabled.
VERIFICATION_STORAGE=local
UPLOADS_DIR=./uploads
# Road routing for errand maps. Get a free token at openrouteservice.org (dashboard -> tokens).
ORS_API_KEY=

# Opt-in backend scheduler. Keep dry-run enabled until its log is reviewed.
EXPIRED_JOB_CLEANUP_ENABLED=false
EXPIRED_JOB_CLEANUP_DRY_RUN=true

# Future dedicated Linux worker only. These paths must be on a real Render disk.
# API instances must keep EXPIRED_JOB_CLEANUP_ENABLED disabled.
GOOGLE_CLOUD_PROJECT=swiftserve-production
EXPIRED_JOB_CLEANUP_DISK_MOUNT=/var/data
EXPIRED_JOB_CLEANUP_STATE_DIR=/var/data/expiry
# Render Pro+ managed OIDC sets GOOGLE_APPLICATION_CREDENTIALS automatically.
# Do not copy the development service-account path into that worker.

# Phone push for job updates and chats (on unless set to false).
PUSH_DISPATCH_ENABLED=true

# SMS one-time codes for sign-up (IPROG SMS).
IPROGSMS_API_TOKEN=
# Random string (32+ characters) used to sign phone-verification tokens.
OTP_TOKEN_SECRET=
# Emergency switch: set to false during an SMS provider outage. Sign-up then skips
# the code step and phone numbers are not verified, so set it back to true afterwards.
PHONE_OTP_REQUIRED=true

# Hosted (Railway): there is no PSA or server-liveness provider, so without this
# nobody can be verified and document review answers "isolated demo emulator
# pilot". When true, a reviewed ID document + face match + admin approval verify
# a worker or client. This is not official government authentication.
VERIFICATION_ADMIN_REVIEW_MODE=false
# Needs VERIFICATION_ADMIN_REVIEW_MODE=true. When true, a strong face match
# verifies a client-only account immediately. Borderline matches, and every
# account with the worker role, still wait for an admin.
VERIFICATION_AUTO_APPROVE=false

# Isolated demo-emulator identity preparation only; never enable on a live project.
NATIONAL_ID_MOCK_ENABLED=false
NATIONAL_ID_MOCK_SCENARIO=manual_review
NATIONAL_ID_FACE_COMPARISON_ENABLED=false
NATIONAL_ID_SYNTHETIC_CHECKS=false
